    "js/OpusGrandStrategyContent.js",
    "Opus.js",
    "js/OpusSummaries.js"
  ],
  "library": [
    "DomBasics.js",
    "UITools.js",
    "DocumentReader.js",
    "DictationWidget.js",
    "SidePanel.js",
    "SupabaseCommentsAdapter.js",
    "CadPlanDataRegistry.js",
    "CadPlanItemNotes.js",
    "CadPlanDocumentEditor.js",
    "CadPlanAardvark.js",
    "SensitiveContextGate.js"
