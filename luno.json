      "Opus/js/OpusQ2NarrativeContent.js"
    ],
    "quadrants-econ-cockpit": [
      "Opus/js/OpusQ3EconomicsContent.js",
      "Opus/js/OpusQ4CockpitContent.js"
    ],
    "grand-strategy": [
      "Opus/js/OpusGrandStrategyContent.js"
